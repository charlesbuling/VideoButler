# Rust
core/target/
**/*.rs.bk

# Pipeline working files. Both are derived from the source media and the
# settings, so they are rebuildable and must never be committed.
_vbcache/
_vbwork/
*.footage-graph.json
*.editing-dsl.json
*.otio
# The contract fixtures are the exception: they are hand-maintained and are
# what keeps the Rust types and the JSON Schemas honest with each other.
!contracts/examples/*.json

# Test media is generated by scripts/make-test-media.sh
test-media/

# Flutter
app/build/
app/.dart_tool/
app/.flutter-plugins*
app/.idea/
app/ios/Pods/
app/macos/Pods/
# Machine-specific: local.properties holds this machine's SDK paths, and the
# .iml files are IDE state.
app/android/local.properties
app/android/.gradle/
**/*.iml
# Regenerated by `flutter pub get`, so committing it only creates conflicts.
**/GeneratedPluginRegistrant.*

.DS_Store

# Cross-compiled engine libraries and the bundled models, both produced by
# scripts/build-android.sh
app/android/app/src/main/jniLibs/
app/android/app/src/main/assets/models/

# ffmpeg source and per-ABI builds, produced by scripts/build-ffmpeg-android.sh
/build/

# AI coding-assistant files: agent instructions, prompts, session and
# planning notes. They stay on the developer's machine, never in the repo.
CLAUDE.md
CLAUDE.local.md
AGENTS.md
GEMINI.md
.claude/
.cursor/
.cursorrules
.codex/
.aider*
.prompts/

# Installers, produced by scripts/package-*.sh
/dist/
